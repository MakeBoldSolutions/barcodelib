<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
     <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>3.4.0</Version>
    <PackageId>BarcodeLib</PackageId>
    <Company>Pnuema Productions</Company>
    <Product>BarcodeLib</Product>
    <Authors>Brad Barnhill</Authors>
    <Description>This library was designed to give an easy class for developers to use when they need to generate barcode images from a string of data.</Description>
    <Copyright>Copyright 2007-2021 Brad Barnhill</Copyright>
    <PackageProjectUrl>https://github.com/MakeBoldSolutions/barcodelib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MakeBoldSolutions/barcodelib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>upca.jpg</PackageIcon>
    <PackageIconUrl />
    <AssemblyVersion>3.4.0.0</AssemblyVersion>
    <FileVersion>3.4.0.0</FileVersion>
    <PackageReleaseNotes>3.4.0: Added QR Code support (TYPE.QRCODE) -- both raster (EncodedImage) and SVG (GetSvg()) output, via a vendored MIT-licensed QR encoder (no new runtime package dependency). Access the 2D module grid via the new EncodedMatrix property; EncodedValue throws NotSupportedException for QR since it's a 1D-only API. 3.3.0: Added Barcode.GetSvg() for vector SVG output alongside the existing raster rendering, sharing the same GS1-aware bar geometry. 3.2.0: Rendered barcodes now reserve a GS1-compliant quiet zone by default (see EnforceGS1QuietZone to opt back into the previous, non-compliant geometry). This changes rendered pixel geometry for UPC-A, EAN-13, and most other symbologies.</PackageReleaseNotes>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="BarcodeLib.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BarcodeLib.nuspec</DependentUpon>
    </Compile>
    <Compile Update="BarcodeXML.Designer.cs">
      <DependentUpon>BarcodeXML.xss</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="BarcodeLib.nuspec">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>BarcodeLib.Designer.cs</LastGenOutput>
    </None>
    <None Update="BarcodeXML.xsc">
      <DependentUpon>BarcodeXML.xsd</DependentUpon>
    </None>
    <None Update="BarcodeXML.xsd">
      <LastGenOutput>BarcodeXML.Designer.cs</LastGenOutput>
      <Generator>MSDataSetGenerator</Generator>
    </None>
    <None Update="BarcodeXML.xss">
      <DependentUpon>BarcodeXML.xsd</DependentUpon>
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>BarcodeXML.Designer.cs</LastGenOutput>
    </None>
    <None Update="Release Notes.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="examples\upca.jpg">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
